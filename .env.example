# 复制为 .env 后按需修改；.env 不入 git，.env.example 入 git 作为参考。
# 后端、前端开发服务器、scripts/manage.py 共用这份配置。

# 后端监听地址与端口（manage.py 启动 uvicorn 用）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3333

# 前端开发服务器端口（manage.py 等待端口 + vite.config.ts 读取）
FRONTEND_PORT=2222

# 同步间隔（分钟）
SYNC_INTERVAL_MINUTES=60

# B 站 Cookie（可选，提高反爬成功率）
BILIBILI_COOKIE=
